#!/usr/bin/env bash

# Assume tmux is available
EXECUTABLE="tmux"
EXEC_NAME="Tmux"
CMD_GET_SESSIONS="${EXECUTABLE} ls"
CMD_ALL_SESSIONS="${CMD_GET_SESSIONS} 2>&1 | grep ':' | grep -v '^$' | awk -F': ' '{print \$1 \";\" \$2 \";\"}' | tr -d '\n'"
CMD_DETACH="${EXECUTABLE} detach-client -s"
CMD_ATTACH="${EXECUTABLE} attach -t"

SCR_MANAGER=$(which tmux)

## If tmux is not found, look for screen
if [ -z "${SCR_MANAGER}" ] ; then
    SCR_MANAGER=$(which screen)

    EXECUTABLE="screen"
    EXEC_NAME="GNU/Screen"
    CMD_GET_SESSIONS="${EXECUTABLE} -ls"
    CMD_ALL_SESSIONS="${CMD_GET_SESSIONS} 2>&1  | grep 'tached' | grep -v '^$' | awk '{print \$1 \";\" \$5 \" \" \$2 \" \" \$3 \" \" $4 \";\"}' | tr -d '\n'"
    CMD_DETACH="${EXECUTABLE} -d"
    CMD_ATTACH="${EXECUTABLE} -r"
fi

## If Neither TMUX nor Screen is found, exit
if [ -z "${SCR_MANAGER}" ] ; then
    echo "Neither tmux nor screen is installed. Please install one of them to manage sessions."
    exit 1
fi

ALL_SCREEN_SESSIONS=$(eval "${CMD_ALL_SESSIONS}")

TOTAL_ELEMENTS=$(echo $ALL_SCREEN_SESSIONS | awk -F';' '{print NF}')

for (( ELEMENT=1; ELEMENT<$TOTAL_ELEMENTS; ELEMENT++ )) ; do
    MY_ARR[$ELEMENT]=$(echo $ALL_SCREEN_SESSIONS | awk -F';' -v col="$ELEMENT" '{print $col}')
done

NUM_ELEMENTS=${#MY_ARR[@]}

if [ "$NUM_ELEMENTS" == 0 ] ; then
    ${EXECUTABLE}
else
    OPTION_NEW="New session"
    OPTION_NO="No session"
    INSTRUC="Make a selection"
    SELECTION=$(whiptail --title "${EXEC_NAME} sessions" --menu "${INSTRUC}" \
        20 80 12 \
        "${OPTION_NEW}" ": Create a new ${EXEC_NAME} session" \
        "${MY_ARR[@]}" \
        "${OPTION_NO}" ": Do not create a new ${EXEC_NAME} session"\
        3>&1 1>&2 2>&3)
    
    if [ ! -z "${SELECTION}" -a "${SELECTION}" != "${OPTION_NO}" ] ; then
        if [ "${SELECTION}" == "${OPTION_NEW}" ] ; then
            ${EXECUTABLE}
        else
            ${CMD_DETACH} $SELECTION
            ${CMD_ATTACH} $SELECTION
        fi
    fi
fi
